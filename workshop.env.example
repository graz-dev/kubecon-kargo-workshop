# Settings of the workshop. This file is the template: the first command you run copies it to workshop.env, which is yours and is not
# kept in git. Anything given on the command line wins over both, e.g. make up HTTP_PORT=8080

# Set this first: your name or handle. Lowercase letters, digits and hyphens, up to 12 characters. Example: anna
WORKSHOP_PREFIX=

# Images
IMAGE_REGISTRY=ghcr.io
IMAGE_OWNER=graz-dev
IMAGE_NAME=kargo-workshop-guestbook
CATALOG_VERSIONS=0.9.0 1.0.0 1.1.0 1.2.0 1.3.0 1.3.1 1.4.0
LIVE_VERSIONS=1.4.0
INITIAL_VERSION=0.9.0

# How a release reaches the Warehouse: ghcr or registry
RELEASE_MODE=ghcr
CLUSTER_REGISTRY=registry.localhost:5000

# Akuity Platform
AKUITY_SERVER_URL=https://akuity.cloud
# Leave empty if your account has a single organization
AKUITY_ORGANIZATION=
# Leave empty for a random password, kept in .tools/admin.env
WORKSHOP_ADMIN_PASSWORD=

# Local environment
CLUSTER_NAME=kargo-workshop
WORKSHOP_DOMAIN=localtest.me
# Use 8080 if port 80 is busy
HTTP_PORT=80
BIND_ADDRESS=127.0.0.1

# Gitea and the GitOps repository
KARGO_PROJECT=guestbook
GITEA_ORG=workshop
GITEA_REPO=guestbook-gitops
GITEA_BRANCH=main
GITEA_ADMIN_USER=workshop-admin
GITEA_ADMIN_PASSWORD=workshop-admin-pw
GITEA_USER=attendee
GITEA_PASSWORD=attendee-pw

# Where attendees send their bootstrap report
SUPPORT_CONTACT=

# Thresholds of make doctor
DOCTOR_MIN_MEM_GB=6
DOCTOR_WARN_MEM_GB=8
DOCTOR_MIN_CPUS=4
DOCTOR_MIN_DISK_GB=15
DOCTOR_MIN_DOCKERHUB_PULLS=40
DOCTOR_MAX_CLOCK_SKEW=120
# What doctor does when the image catalog cannot be pulled: fail, warn or skip
DOCTOR_IMAGE_CHECK=fail

# AWS (Lab 11): every asset created in the AWS account gets these tags, with cost_center=marketing fixed in the Terraform code
AWS_TAG_OWNER=graziano.casto@akuity.io
AWS_TAG_PURPOSE=kargo-workshop-kubecon-na-2026
AWS_REGION=us-east-1
AWS_STATE_BUCKET=kcd-workshop
AWS_EXECUTION_ROLE_ARN=arn:aws:iam::218691292270:role/lambda-execution-role
AWS_FUNCTION_PREFIX=kargo-guestbook
